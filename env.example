# --- Public address -----------------------------------------------------
# Set this when the bot runs behind a reverse proxy (Coolify, Traefik, nginx).
# OAuth redirects and overlay URLs are derived from it, TLS is left to the
# proxy, and the separate overlay port is no longer needed.
# Leave it empty for a local install.
PUBLIC_URL=

# --- Twitch -------------------------------------------------------------
# Create an application at https://dev.twitch.tv/console/apps
# The redirect URL registered there must match the one the bot uses exactly.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=your_channel
# Optional: derived from PUBLIC_URL (or the local address) when left empty.
TWITCH_REDIRECT_URI=

# There is no TWITCH_OAUTH setting any more: the chat token is obtained
# through the dashboard and refreshed automatically.

# --- Web dashboard ------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Set to false only for local development; it disables the login screen.
WEB_AUTH_ENABLED=true

# Plain-HTTP listener for OBS browser sources, guarded by a generated key.
# Defaults to WEB_PORT + 1.
OVERLAY_PORT=3001

# --- Bot ----------------------------------------------------------------
BOT_PREFIX=!
LANGUAGE=fr
LOG_LEVEL=info
# Set to false to run everything except the chat connection.
BOT_CHAT_ENABLED=true

# --- Spotify (optional) -------------------------------------------------
# https://developer.spotify.com/dashboard - the refresh token is stored in
# data/tokens/spotify.json after connecting from the dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: derived from PUBLIC_URL when left empty.
SPOTIFY_REDIRECT_URI=
SPOTIFY_PLAYLIST_ID=

# --- OBS (optional) -----------------------------------------------------
# Tools > WebSocket Server Settings in OBS Studio.
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# --- Apex Legends (optional) --------------------------------------------
# https://portal.mozambiquehe.re
APEX_API_KEY=
APEX_USERNAME=
APEX_PLATFORM=PC
