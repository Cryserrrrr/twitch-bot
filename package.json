{
  "name": "twitch-bot",
  "version": "2.0.0",
  "description": "Twitch chat bot with a web dashboard and Spotify, OBS and Apex Legends integrations",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node --no-deprecation src/index.js",
    "dev": "nodemon --no-deprecation --watch src --ext js,json,html src/index.js",
    "build": "npm --prefix dashboard run build",
    "dashboard": "npm --prefix dashboard run dev",
    "install:all": "npm install && npm --prefix dashboard install"
  },
  "keywords": [
    "twitch",
    "bot",
    "dashboard",
    "spotify",
    "obs",
    "apex"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "obs-websocket-js": "^5.0.3",
    "spotify-web-api-node": "^5.0.2",
    "sqlite3": "^5.1.6",
    "tmi.js": "^1.8.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
